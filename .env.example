# Nearby: every environment variable, with placeholder values only (spec 3.13). No real credential is ever committed.
# PayPal runs in the sandbox only: the app refuses to start unless PAYPAL_BASE_URL is the sandbox URL below.
DATABASE_URL=postgres://user:password@localhost:5432/nearby
APP_BASE_URL=http://localhost:3000
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=your-claude-model-id
AGENT_DISABLED=false
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
GOOGLE_MAPS_SERVER_KEY=your-places-api-key-restricted-to-places
GOOGLE_MAPS_BROWSER_KEY=your-maps-javascript-key-restricted-to-your-domain
APP_REPO_URL=https://github.com/your-account/nearby
