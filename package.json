{
  "name": "nearby",
  "version": "1.0.0",
  "private": true,
  "description": "Nearby: an AI agent that finds local offers near your appointments and pays with PayPal (sandbox demo with sample data).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:client": "vite",
    "build": "vite build && tsc -p tsconfig.server.json && node scripts/copy-sql.mjs",
    "start": "node dist/server/server.js",
    "seed": "node dist/server/seed/run.js",
    "seed:dev": "tsx src/seed/run.ts",
    "test": "vitest run",
    "lint": "eslint . && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "record:fixtures": "tsx src/services/adapters/recordFixtures.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^8.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.12.8",
    "lucide-react": "^1.72.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.32",
    "tailwindcss": "3.4",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
