{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["src/main.tsx", "src/components/**/*", "src/pages/**/*", "src/hooks/**/*", "src/styles/**/*", "src/shared/**/*", "src/client/**/*"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
